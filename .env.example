# Copy this file to .env.local. Never commit .env.local.

# Public site profile. Safe to expose in the browser.
NEXT_PUBLIC_AUTHOR_NAME=
NEXT_PUBLIC_GITHUB_URL=
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase. Leave blank until the project exists.
# The anon key is public by design. The service-role key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Zotero. Used later by GitHub Actions, not by the website.
# ZOTERO_API_KEY=
# ZOTERO_LIBRARY_ID=
# ZOTERO_LIBRARY_TYPE=user
